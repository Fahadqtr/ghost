# Commerce AI OS — environment template (canonical)
# Copy to `.env.local` and fill in real values. NEVER commit real keys —
# `.env`, `.env.local`, and `.env*.local` are gitignored.

# --- Supabase ---------------------------------------------------------------
# Supabase project -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only service-role key. Bypasses RLS — used by agents / loop_state
# writes / seeding scripts. Do NOT expose to the browser (no NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Anthropic (agents: manager, specialists, Compliance Checker) -----------
# https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY
