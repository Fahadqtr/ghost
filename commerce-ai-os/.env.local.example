# Commerce AI OS — environment template
# Copy this file to `.env.local` for local dev, and add the SAME variables in
# Vercel (Project -> Settings -> Environment Variables) for Preview + Production.
# `.env.local` is gitignored and must NEVER be committed. Never paste real keys
# anywhere except your local `.env.local` and the Vercel dashboard.

# ── Supabase (database) ─────────────────────────────────────────────────────
# Supabase -> Project Settings -> API.
# IMPORTANT: use the BASE project URL only — WITHOUT a "/rest/v1/" suffix.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Server-only privileged key (service role / secret key). Never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-OR-SECRET-KEY

# ── Malak brain (required) ──────────────────────────────────────────────────
# Claude API key powering /api/malak (the agent brain). Without it the office
# chat replies: "مفتاح ANTHROPIC_API_KEY غير مهيأ على الخادم".
ANTHROPIC_API_KEY=
# Optional: override the brain model (defaults to claude-opus-4-8).
MALAK_MODEL=

# ── Write-confirm signing (REQUIRED in production) ──────────────────────────
# HMAC secret that signs price/stock/approval confirm tokens (/api/malak/commit).
# Required in production (the app refuses to start signing without it so the key
# isn't coupled to the DB master key); preview/dev fall back to the service key.
# Generate one with:  openssl rand -hex 32
MALAK_SIGNING_SECRET=

# ── Voice TTS (optional — ElevenLabs, Gulf voices) ──────────────────────────
# If unset, /api/malak/speak returns 204 and the page uses the browser voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # fallback voice (Malak)
ELEVENLABS_MODEL_ID=          # optional; defaults to eleven_multilingual_v2
# Optional per-agent voice overrides (else the hardcoded library voices are used):
# ELEVENLABS_VOICE_NOOR=
# ELEVENLABS_VOICE_REEM=
# ELEVENLABS_VOICE_SIRAJ=
# ELEVENLABS_VOICE_RAZAN=
# ELEVENLABS_VOICE_RASHID=
# ELEVENLABS_VOICE_LATIFA=

# ── Product image generation (optional — used by Reem) ──────────────────────
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=           # optional; image model override

# ── Web browsing (optional — Malak's browse_web tool / popup browser screen) ─
# Vercel functions can't run Chromium, so the browser lives on an external
# Browserless-compatible service. Without these, browsing replies "خدمة المتصفح
# غير مهيأة" and the popup screen shows a config hint — nothing else breaks.
# browserless.io (cloud) -> account -> API URL + token, or self-host.
BROWSERLESS_URL=              # e.g. https://production-sfo.browserless.io
BROWSERLESS_TOKEN=            # API token for that service

# ── Web search (optional — Malak's web_search tool) ─────────────────────────
# Scraping Google/Bing from the browser service trips their CAPTCHA wall, so
# "search the net" uses a real search API instead. Set ONE of these.
# Brave Search API (free tier ~2k/mo): https://api-dashboard.search.brave.com
BRAVE_SEARCH_TOKEN=
# Or Tavily (AI search, free tier ~1k/mo): https://tavily.com
TAVILY_API_KEY=

# ── Live browser w/ audio (optional — Malak's open_live_browser tool) ────────
# Hyperbeam streams a real interactive virtual browser (video + AUDIO) into an
# iframe on the user's device — what screenshots/CDP can't do. Free tier
# available: https://hyperbeam.com. Without it, the live tool degrades to a
# "not configured" message and screenshots still work.
HYPERBEAM_API_KEY=
# Server region for the live VM (closest = best stream). EU/AS/NA. Defaults to
# EU (closest to the Gulf); Hyperbeam's own default NA blacks out over mobile.
HYPERBEAM_REGION=
# Optional live-VM frame rate (5-30). Lower = smoother on mobile. Default 15.
HYPERBEAM_FPS=

# ── Fast live browser for NON-audio sites (optional — Browserbase) ───────────
# Shopping/general browsing use a lighter, snappier interactive stream (no
# audio); YouTube/music still use Hyperbeam. Get both from browserbase.com.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
