# Commerce AI OS — environment template
# Copy this file to `.env.local` and paste your real Supabase values.
# `.env.local` is gitignored and must NEVER be committed.
#
# Find these in your Supabase project:
#   Project Settings -> API -> Project URL  (NEXT_PUBLIC_SUPABASE_URL)
#   Project Settings -> API -> anon public key  (NEXT_PUBLIC_SUPABASE_ANON_KEY)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: server-only key for privileged scripts (seeding, admin tasks).
# Do NOT expose this to the browser. Leave blank in Phase 1 if unused.
SUPABASE_SERVICE_ROLE_KEY=
