# Commerce AI OS — environment template
# Copy this file to `.env.local` for local dev, and add the SAME variables in
# Vercel (Project -> Settings -> Environment Variables) for Preview + Production.
# `.env.local` is gitignored and must NEVER be committed. Never paste real keys
# anywhere except your local `.env.local` and the Vercel dashboard.

# ── Supabase (database) ─────────────────────────────────────────────────────
# Supabase -> Project Settings -> API.
# IMPORTANT: use the BASE project URL only — WITHOUT a "/rest/v1/" suffix.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Server-only privileged key (service role / secret key). Never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-OR-SECRET-KEY

# ── Malak brain (required) ──────────────────────────────────────────────────
# Claude API key powering /api/malak (the agent brain). Without it the office
# chat replies: "مفتاح ANTHROPIC_API_KEY غير مهيأ على الخادم".
ANTHROPIC_API_KEY=
# Optional: override the brain model (defaults to claude-opus-4-8).
MALAK_MODEL=

# ── Write-confirm signing (recommended) ─────────────────────────────────────
# HMAC secret that signs price/stock/approval confirm tokens (/api/malak/commit).
# Generate one with:  openssl rand -hex 32
MALAK_SIGNING_SECRET=

# ── Voice TTS (optional — ElevenLabs, Gulf voices) ──────────────────────────
# If unset, /api/malak/speak returns 204 and the page uses the browser voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # fallback voice (Malak)
ELEVENLABS_MODEL_ID=          # optional; defaults to eleven_multilingual_v2
# Optional per-agent voice overrides (else the hardcoded library voices are used):
# ELEVENLABS_VOICE_NOOR=
# ELEVENLABS_VOICE_REEM=
# ELEVENLABS_VOICE_SIRAJ=
# ELEVENLABS_VOICE_RAZAN=
# ELEVENLABS_VOICE_RASHID=
# ELEVENLABS_VOICE_LATIFA=

# ── Product image generation (optional — used by Reem) ──────────────────────
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=           # optional; image model override
